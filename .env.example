# --- Supabase (Project Settings > API). Create the project in the Mumbai (ap-south-1) region.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used by cron routes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random long string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- Email notifications (https://resend.com). Leave empty to disable emails.
RESEND_API_KEY=
EMAIL_FROM="Tender Zipper <no-reply@tenderzipper.in>"

# --- Coming in later phases (kept here so the list is complete)
# RAZORPAY_KEY_ID=            # Phase 2 subscriptions
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# WHATSAPP_BSP_API_KEY=       # Phase 2 WhatsApp alerts (Interakt / Gupshup / AiSensy)
# MSG91_AUTH_KEY=             # SMS OTP via Supabase "Send SMS" auth hook
# SUREPASS_API_TOKEN=         # Phase 2 KYC auto-verification
# TYPESENSE_API_KEY=          # Phase 2 search
# UPSTASH_REDIS_REST_URL=     # Phase 2 rate limiting
# UPSTASH_REDIS_REST_TOKEN=
# NEXT_PUBLIC_GOOGLE_MAPS_KEY= # Phase 3 live tracking
# ANTHROPIC_API_KEY=          # Phase 4 AI tender assistant
